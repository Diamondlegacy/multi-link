# Copy this to Vercel's Environment Variables settings (not committed to git).
# Do NOT put real values in this file or commit a .env with real secrets.

# Vercel Postgres sets this automatically once you connect a database
# to your project — you usually don't need to set it by hand.
POSTGRES_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 32 bytes (64 hex characters) — used to encrypt bank account numbers.
BANK_ENCRYPTION_KEY=
